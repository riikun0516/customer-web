<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS環境向け設定。
  このディレクトリ内のファイル（アップロードされたロゴ画像など）はブラウザから
  画像として表示できる必要があるため、config/includes/logsのような完全アクセス拒否ではなく、
  「PHPとして実行させない」設定のみを行う。
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- .php 拡張子であってもPHPハンドラーには渡さず、静的ファイルとして扱う（＝実行されない） -->
      <clear />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
    </handlers>
  </system.webServer>
</configuration>
